config {
  type: "view",
  schema: dataform.projectConfig.vars.consumption_dataset,
  name: "vw_customer_value",
  tags: ["consumption"],
  description: "One row per customer with inline city-region mapping for RLS."
}

WITH city_region_map AS (
  SELECT 'Yogyakarta' AS city_name, 'Jawa' AS region_name UNION ALL
  SELECT 'Jakarta', 'Jawa' UNION ALL
  SELECT 'Bandung', 'Jawa' UNION ALL
  SELECT 'Surabaya', 'Jawa' UNION ALL
  SELECT 'Semarang', 'Jawa' UNION ALL
  SELECT 'Denpasar', 'Jawa' UNION ALL
  SELECT 'Medan', 'Sumatra' UNION ALL
  SELECT 'Makasar', 'Sulawesi'
)

SELECT
  c.customer_id             AS customer,
  c.customer_name,
  c.customer_type,
  c.city,
  c.province,
  c.join_date,
  rfm.recency_days,
  rfm.frequency_orders,
  rfm.monetary_total        AS lifetime_value_idr,
  rfm.avg_order_value       AS avg_order_value_idr,
  rfm.recency_score,
  rfm.frequency_score,
  rfm.monetary_score,
  rfm.rfm_code,
  rfm.rfm_segment,
  
  acc.viewer_email

FROM ${ref("dim_customer")} c
LEFT JOIN ${ref("mart_rfm_analysis")} rfm USING (customer_id)
LEFT JOIN city_region_map reg ON LOWER(c.city) = LOWER(reg.city_name)

INNER JOIN ${ref("mart_user_access")} acc 
  ON (
    -- 1. Sales Representative
    (acc.access_type = 'CITY' AND LOWER(c.city) = LOWER(acc.allowed_value))
    
    -- 2. Regional Manager (Menggunakan CTE Inline Mapping)
    OR (acc.access_type = 'REGION' AND LOWER(reg.region_name) = LOWER(acc.allowed_value))
    
    -- 3. Category Manager
    OR (acc.access_type = 'CATEGORY')
    
    -- 4. National Director & Admin
    OR acc.access_type = 'ALL'
  )