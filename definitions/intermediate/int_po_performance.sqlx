config {
  type: "table",
  schema: dataform.projectConfig.vars.intermediate_dataset,
  name: "int_po_performance",
  tags: ["intermediate"],
  description: "Per SKU x Supplier: actual lead time avg/stddev, on-time rate, fill rate, cancellation rate — derived purely from purchase_orders history."
}

SELECT
  sku_id,
  supplier_id,
  COUNT(*)                                                  AS total_po_lines,
  COUNTIF(po_status = 'RECEIVED')                           AS received_po_lines,
  COUNTIF(po_status = 'PARTIAL')                             AS partial_po_lines,
  COUNTIF(po_status = 'CANCELLED')                           AS cancelled_po_lines,
  COUNTIF(po_status = 'OPEN')                                AS open_po_lines,
  ROUND(AVG(lead_time_actual_days), 2)                       AS avg_lead_time_actual_days,
  ROUND(STDDEV_SAMP(lead_time_actual_days), 2)                AS stddev_lead_time_actual_days,
  ROUND(SAFE_DIVIDE(COUNTIF(days_late <= 0), COUNTIF(actual_receipt_date IS NOT NULL)), 3) AS on_time_rate,
  ROUND(AVG(fill_rate), 3)                                    AS avg_fill_rate
FROM ${ref("stg_purchase_orders")}
GROUP BY 1, 2
