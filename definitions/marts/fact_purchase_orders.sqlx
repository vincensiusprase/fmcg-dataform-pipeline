config {
  type: "table",
  schema: dataform.projectConfig.vars.mart_dataset,
  name: "fact_purchase_orders",
  tags: ["mart", "fact"],
  description: "Grain: 1 row per PO line, with lateness/fill-rate flags.",
  assertions: {
    uniqueKey: ["po_id"],
    nonNull: ["po_id", "sku_id", "supplier_id", "po_date"]
  }
}

SELECT
  po_id,
  po_date,
  supplier_id,
  sku_id,
  order_qty,
  expected_date,
  actual_receipt_date,
  received_qty,
  unit_cost,
  po_status,
  lead_time_actual_days,
  days_late,
  fill_rate,
  CASE WHEN days_late > 0 THEN TRUE WHEN days_late <= 0 THEN FALSE ELSE NULL END AS is_late
FROM ${ref("stg_purchase_orders")}
